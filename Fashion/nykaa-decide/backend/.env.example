# Backend environment — copy to .env locally, set as env vars on Render.
# NEVER commit the real .env.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Port. Render injects this automatically; 8731 is the local default.
PORT=8731

# Comma-separated origin allowlist for CORS, e.g.
#   https://nykaa-decide.vercel.app,http://localhost:5173
# Leave blank to allow any origin (prototype default).
ALLOWED_ORIGINS=
