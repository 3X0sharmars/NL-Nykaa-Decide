# Frontend build-time config. Copy to .env.local for local overrides.
# On Vercel set this in Project Settings → Environment Variables.

# Absolute URL of the backend on Render, no trailing slash, e.g.
#   https://nykaa-decide-api.onrender.com
# Leave blank to call the same origin (uses the Vite dev proxy locally).
VITE_API_BASE=
