# Copy this file to .env and fill in. NEVER commit .env.

# --- PHASE 3 (classification) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- PHASE 1B MODULE A: X / Twitter ---
# App-only bearer token for the X API v2 recent-search endpoint.
# https://developer.x.com  -> project -> Keys and tokens -> Bearer Token
# Quota controls live in config.py (X_MAX_REQUESTS_TOTAL,
# X_MAX_RESULTS_PER_REQUEST, X_TOKEN_BUCKET_DELAY_S) and are tunable there
# without touching code.
X_BEARER_TOKEN=

# --- PHASE 1B MODULE B: SerpApi ---
# https://serpapi.com/manage-api-key
SERPAPI_KEY=

# --- Reddit: OUT OF SCOPE as of Phase 1B. Not attempted by any route. ---
